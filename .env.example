# ==============================================================================
# PHARMORA Phase 1 — Environment Variables Template
#
# IMPORTANT:
# - Copy this file to .env before starting the development server.
# - NEVER commit actual secrets, service role keys, or database passwords.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Variables (Vite - exposed to client bundle via VITE_ prefix)
# ------------------------------------------------------------------------------
# Supabase project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase public anonymous API key (safe for browser client with RLS enabled)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Express backend API base URL
VITE_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# Backend Server Variables (Node/Express - strictly private server-side)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Allowed CORS origins (comma-separated for multiple)
CLIENT_URL=http://localhost:5173

# Supabase Server-side Configuration
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (Privileged! NEVER expose to client/browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Admin bootstrap secret (used only for initial administrative seeding)
ADMIN_BOOTSTRAP_SECRET=change-this-to-a-secure-random-secret
